# Copy to /opt/ecareplus/.env on the VM. Never commit the real file.
API_IMAGE=asia-south1-docker.pkg.dev/PROJECT_ID/ecareplus/api:latest
API_DOMAIN=api.irehabcare.com
LIVEKIT_DOMAIN=lk.irehabcare.com

LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_URL=wss://lk.irehabcare.com

# Supabase (Phase 5). Pooler URL for the app; direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# AI via OpenRouter. Model ids default in apps/api/src/ai-service/ai.config.ts
OPENROUTER_API_KEY=
ADMIN_API_TOKEN=

# Same variables as apps/api/.env.example
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=
BREVO_API_KEY=
EMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.irehabcare.com/auth/google/callback
FRONTEND_URL=https://irehabcare.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=production
PORT=8000
