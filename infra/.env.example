# Copy to /opt/ecareplus/.env on the VM. Never commit the real file.
API_IMAGE=asia-south1-docker.pkg.dev/PROJECT_ID/ecareplus/api:latest
API_DOMAIN=api.irehabcare.com
LIVEKIT_DOMAIN=lk.irehabcare.com

LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_URL=wss://lk.irehabcare.com

# Supabase (Phase 5). Pooler URL for the app; direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# AI via Z.ai GLM. Model ids default in apps/api/src/ai-service/ai.config.ts
GLM_KEY=
ADMIN_API_TOKEN=

# Same variables as apps/api/.env.example
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=
EMAIL_USER=
EMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.irehabcare.com/auth/google/callback
FRONTEND_URL=https://irehabcare.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=production
PORT=8000

# RCI register encryption key: openssl rand -base64 32 (must match the key the register was imported with)
RCI_ENCRYPTION_KEY=

# TURN relay (coturn service in docker-compose.yml) so video calls connect on mobile data / strict NATs.
# TURN_SHARED_SECRET: openssl rand -hex 32. TURN_EXTERNAL_IP: the VM's public IP.
TURN_URLS=turn:34.14.138.47:3478?transport=udp,turn:34.14.138.47:3478?transport=tcp
TURN_SHARED_SECRET=
TURN_EXTERNAL_IP=34.14.138.47
