# Backend API base URL
NEXT_PUBLIC_BASE_ENDPOINT=http://localhost:8000

# Address of the doctor site. Used by the "For Doctors" footer link. Unset = use /for-doctors on this site.
# Production: https://doctors.irehabcare.com    Local: http://doctors.localhost:3000
NEXT_PUBLIC_DOCTORS_URL=

# Main site address, used for meeting links doctors share with patients. Unset = the current site.
# Production: https://irehabcare.com
NEXT_PUBLIC_MAIN_URL=
