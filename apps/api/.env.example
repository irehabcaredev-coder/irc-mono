# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ecare_plus"
# Used by prisma migrate. Same as DATABASE_URL locally; for Supabase use the direct/session string (port 5432)
DIRECT_URL="postgresql://username:password@localhost:5432/ecare_plus"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Session
SESSION_SECRET="your-session-secret-change-in-production"

# Email (Gmail SMTP via nodemailer)
# EMAIL_USER is the Gmail address. EMAIL_APP_PASSWORD is a 16-character Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords), not the account password.
EMAIL_USER="your-address@gmail.com"
EMAIL_APP_PASSWORD="your-16-char-app-password"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"  # Your backend callback URL

# Frontend URLs - CRITICAL for OAuth redirects
FRONTEND_URL="http://localhost:3000"  # Your frontend base URL (React/Vue/etc)
# Where doctors land after Google sign-in (the doctor site). Unset = same as FRONTEND_URL.
# DOCTORS_FRONTEND_URL="https://doctors.irehabcare.com"

# Server
PORT=8000  # Backend port (different from frontend)
NODE_ENV="development"
ALLOW_MOCK_OTP="true"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"


# AI (OpenRouter). Model ids default in src/ai-service/ai.config.ts; override per task if needed.
OPENROUTER_API_KEY=""
# AI_MODEL_LEAD="anthropic/claude-haiku-4.5"
# AI_MODEL_DOCTOR_CHAT="anthropic/claude-sonnet-4.5"
# AI_MODEL_PATIENT_CHAT="anthropic/claude-sonnet-4.5"
# AI_MODEL_FILE="anthropic/claude-sonnet-4.5"
# AI_ANON_MESSAGE_LIMIT=20
# AI_FILE_LIMIT=100

# Admin API for editing the doctor/patient master prompts (PUT /ai/admin/prompts/:role). Unset = disabled.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=""

# RCI register encryption (AES-256-GCM + HMAC blind index). 32 random bytes, base64: openssl rand -base64 32
# Losing or changing this makes the stored RCI data unreadable; re-import with src/scripts/import-rci.ts.
RCI_ENCRYPTION_KEY=""
