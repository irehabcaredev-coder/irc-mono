# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ecare_plus"
# Used by prisma migrate. Same as DATABASE_URL locally; for Supabase use the direct/session string (port 5432)
DIRECT_URL="postgresql://username:password@localhost:5432/ecare_plus"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Session
SESSION_SECRET="your-session-secret-change-in-production"

# Email (Brevo)
BREVO_API_KEY="your-brevo-api-key"
EMAIL_USER="noreply@ecareplus.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"  # Your backend callback URL

# Frontend URLs - CRITICAL for OAuth redirects
FRONTEND_URL="http://localhost:3000"  # Your frontend base URL (React/Vue/etc)

# Server
PORT=8000  # Backend port (different from frontend)
NODE_ENV="development"
ALLOW_MOCK_OTP="true"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# LiveKit (local dev server defaults shown; see infra/docker-compose.local.yml)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# AI (OpenRouter). Model ids default in src/ai-service/ai.config.ts; override per task if needed.
OPENROUTER_API_KEY=""
# AI_MODEL_LEAD="anthropic/claude-haiku-4.5"
# AI_MODEL_DOCTOR_CHAT="anthropic/claude-sonnet-4.5"
# AI_MODEL_PATIENT_CHAT="anthropic/claude-sonnet-4.5"
# AI_MODEL_FILE="anthropic/claude-sonnet-4.5"
# AI_ANON_MESSAGE_LIMIT=20
# AI_FILE_LIMIT=100
